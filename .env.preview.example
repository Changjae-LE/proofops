# Copy this to .env.preview and set exactly ONE of the following for a wallet funded via
# the Preview faucet: https://midnight-tmnight-preview.nethermind.dev/
# The wallet also needs tDUST, delegated from tNIGHT via 1AM or Lace.
MIDNIGHT_NETWORK=preview
MIDNIGHT_PREVIEW_SEED=replace-with-a-64-char-hex-seed
# MIDNIGHT_PREVIEW_MNEMONIC=replace-with-24-word-mnemonic

# Set after the first `npm run midnight:deploy` on this network.
# MIDNIGHT_CONTRACT_ADDRESS=
