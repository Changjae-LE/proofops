# Proof provider selection: "local" (default, always works, no network needed) or "midnight"
VITE_PROOF_PROVIDER=local

# Cosmetic-only label shown in the UI badge before the real status loads from the server.
# The authoritative network is whatever MIDNIGHT_NETWORK (below) is set to.
VITE_MIDNIGHT_NETWORK=undeployed

# --- Server-side only below this line: NEVER prefix these with VITE_. ---
# Vite inlines every VITE_* variable into the public browser bundle - wallet secrets and
# Node-only SDK config must stay server-side (see server/midnight/*, docs/MIDNIGHT_STATUS.md).

# Real Midnight network selection: "local" (Docker devnet via `npm run midnight:env:up`),
# "preview", or "preprod".
MIDNIGHT_NETWORK=local

# Wallet secret for the active network. Set exactly ONE of the SEED or MNEMONIC vars for
# MIDNIGHT_NETWORK=preview or =preprod ("local" needs neither - it uses the well-known
# public devnet seed baked into server/midnight/config.ts). Fund the wallet via the
# network's faucet page first (see docs/MIDNIGHT_STATUS.md). Put real values in
# .env.preview / .env.preprod (already gitignored) - never in this file, never committed.
# MIDNIGHT_PREVIEW_SEED=
# MIDNIGHT_PREVIEW_MNEMONIC=
# MIDNIGHT_PREPROD_SEED=
# MIDNIGHT_PREPROD_MNEMONIC=

# Set after `npm run midnight:deploy` to join that same contract on future server starts
# instead of deploying a new one.
# MIDNIGHT_CONTRACT_ADDRESS=

# Override if the proof server is not at the default http://127.0.0.1:6300.
# MIDNIGHT_PROOF_SERVER=

# Express server port
PORT=8787
