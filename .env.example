# Proof provider selection: "local" (default, always works) or "midnight"
VITE_PROOF_PROVIDER=local

# Network label shown in the UI when VITE_PROOF_PROVIDER=midnight
VITE_MIDNIGHT_NETWORK=undeployed

# Midnight indexer / node / proof-server endpoints (only used when VITE_PROOF_PROVIDER=midnight)
VITE_MIDNIGHT_INDEXER_URL=
VITE_MIDNIGHT_NODE_URL=
VITE_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Express server port
PORT=8787
