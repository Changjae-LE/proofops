# Copy this to .env.preprod and set exactly ONE of the following for a wallet funded via
# the Preprod faucet: https://midnight-tmnight-preprod.nethermind.dev/
# The wallet also needs tDUST, delegated from tNIGHT via 1AM or Lace.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PREPROD_SEED=replace-with-a-64-char-hex-seed
# MIDNIGHT_PREPROD_MNEMONIC=replace-with-24-word-mnemonic

# Set after the first `npm run midnight:deploy` on this network.
# MIDNIGHT_CONTRACT_ADDRESS=
